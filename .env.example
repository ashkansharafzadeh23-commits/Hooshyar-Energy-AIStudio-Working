# Server & Environment
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=hooshyar-energy
JWT_AUDIENCE=hooshyar-api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL optional for local dev; falls back to in-memory JSON db.json)
DATABASE_URL=
DB_DRIVER=json
PG_MAX_CONNECTIONS=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# AI Integrations
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=15000
ANTHROPIC_API_KEY=

# External Services
NASA_POWER_TIMEOUT_MS=8000
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=
SMS_PATTERN=
SMS_TEMPLATE=
SMS_USER=
KAVENEGAR_API_KEY=

# Payment Gateway (Zarinpal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_TIMEOUT_MS=10000

# Partner & Enterprise
FINANCING_PARTNER_SECRET=
BANK_API_KEY=

# Rate Limiting & Performance
DISABLE_RATE_LIMIT=false
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_UPLOAD_MAX=10
LOG_LEVEL=info
